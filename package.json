{
  "name": "peapod-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống tự động hóa nội dung Facebook B2B (VN/JP) - mã nguồn. Tài liệu: repo ba-team.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "start:api": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fontsource/noto-sans": "5.2.10",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "satori": "0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
