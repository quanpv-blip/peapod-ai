# --- Hạ tầng cục bộ (docker compose) ---
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
API_BIND=127.0.0.1
APP_DOMAIN=            # chỉ cần khi dùng profile prod (Caddy)

# Mẫu biến môi trường. KHÔNG điền giá trị thật vào file này và KHÔNG commit file .env thật.
# Bí mật thật: đặt trong secret manager hoặc file .env trên VPS (chmod 600, chủ sở hữu = user chạy app).

# --- Ứng dụng ---
APP_BASE_URL=https://automation.example.com
TZ=UTC                        # lưu UTC; hiển thị theo múi giờ từng thị trường ở lớp UI
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/peapod

# --- xAI ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_JP=grok-4.7
XAI_MODEL_VN=grok-4.3
XAI_MODEL_RESEARCH=grok-4.3
XAI_MODEL_VIDEO=grok-imagine-video-1.5-lite
XAI_TTS_VOICE_JP=eve         # chọn sau PoC (GET /v1/tts/voices)
XAI_TTS_VOICE_VN=eve
XAI_MAX_PROMPT_TOKENS=150000  # chặn trước ngưỡng 200k (giá nhân đôi)

# --- Meta ---
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
FB_VN_PAGE_ID=
FB_VN_PAGE_TOKEN=
FB_SYSTEM_USER_TOKEN=          # token System User (không hết hạn); dùng để đổi lấy Page token
FB_JP_PAGE_ID=
FB_JP_PAGE_TOKEN=
META_BUC_PAUSE_THRESHOLD=80   # % ; vượt thì tạm dừng đăng
META_BUC_PAUSE_MINUTES=30

# --- Thông báo & duyệt ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=         # bắt buộc nếu dùng nút bấm Slack
NOTIFY_CHANNEL_ID=
AUTH_SESSION_SECRET=         # >= 32 ký tự ngẫu nhiên (openssl rand -base64 48)
APPROVER_ALLOWLIST_VN=        # danh sách email, phân tách bằng dấu phẩy
APPROVER_ALLOWLIST_JP=

# --- Media ---
MEDIA_DIR=/data/media
MEDIA_RETENTION_DAYS=7
RENDER_CONCURRENCY=1

COOKIE_SECURE=false           # true khi chạy sau HTTPS (prod)

# Cảnh báo qua Telegram (để trống thì tắt). Token của bot từ @BotFather; chat id là ID nhóm (số âm).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram: ID người được dùng lệnh bot (phân tách bằng dấu phẩy). Mỗi người gửi /start cho bot để biết ID của mình.
TELEGRAM_ALLOWED_USER_IDS=

# Truy cập từ mạng LAN: đặt API_BIND=0.0.0.0 và APP_BASE_URL=http://<IP máy>:<cổng>. Chỉ dùng trong mạng tin cậy; không có HTTPS.

# Dịch vụ render thẻ Remotion (peapod-video, chạy trên máy chủ). Để trống thì dùng Satori.
# URL trong container: http://host.docker.internal:4100. Token phải trùng RENDER_TOKEN của peapod-video.
REMOTION_RENDER_URL=
REMOTION_RENDER_TOKEN=

# Tab "Biên tập video" nhúng Remotion Studio (chạy npm run studio trong peapod-video). Địa chỉ mà TRÌNH DUYỆT truy cập được, không phải địa chỉ trong container. Để trống thì tab báo chưa cấu hình.
REMOTION_STUDIO_URL=
